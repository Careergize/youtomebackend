DJANGO_DEBUG=true
# Optional PostgreSQL connection. Leave DB_HOST empty to use local SQLite.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=verify-full
DB_SSLROOTCERT=../global-bundle.pem
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=https://www.you2mematrimonial.com,https://you2mematrimonial.com
OTP_DELIVERY_MODE=local
# Temporary test access with code 1234, including when DEBUG=false.
OTP_ALLOW_TEST_CODE=false
# Set OTP_DELIVERY_MODE=msg91 to send real SMS with these server-only credentials.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# JSON array of RTCIceServer objects. Add a TURN relay for calls across restrictive networks.
WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
